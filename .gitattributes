# Preserve generated source snapshots exactly across Windows and Linux.
examples/sco-private/after-public.mjs text eol=lf
examples/sco-private/before-private.mjs text eol=lf
examples/coo-shards/before/main.mjs text eol=lf
examples/coo-shards/after/*.mjs text eol=lf
examples/sco-graph/before/*.mjs text eol=lf
examples/sco-graph/after/*.mjs text eol=lf

examples/coo-native-shards/before/*.mjs text eol=lf
examples/coo-native-shards/after/*.mjs text eol=lf
examples/coo-native-shards/after-paired/*.mjs text eol=lf
examples/primitive-coercer/*.cjs text eol=lf
examples/owned-constant-key/*.cjs text eol=lf
examples/imported-constant-key/before/*.mjs text eol=lf
examples/imported-constant-key/after/*.mjs text eol=lf

examples/application-challenge/before/*.mjs text eol=lf
examples/application-challenge/after/*.mjs text eol=lf
examples/application-challenge/sco-before/*.mjs text eol=lf
examples/application-challenge/sco-public/**/*.mjs text eol=lf

# Exact ESM host-guard output includes generated LF prefix bytes.
examples/closed-graph-host/before/*.mjs text eol=lf
examples/closed-graph-host/after/*.mjs text eol=lf

# A reviewed CSS asset must have identical bytes on Windows and Linux.
examples/reviewed-assets-cli/source/theme.css text eol=lf

# Freeze npm manifest and resolved lock bytes across Windows and Linux.
package.json text eol=lf
package-lock.json text eol=lf

# Frozen stateful ARX three-arm source artifacts and byte-exact ESBuild baseline.
examples/stateful-arx-app/native/*.mjs text eol=lf
examples/stateful-arx-app/minified/*.mjs text eol=lf
examples/stateful-arx-app/wasm/*.mjs text eol=lf
