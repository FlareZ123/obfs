{
  "name": "obfs-research",
  "version": "0.1.0",
  "private": true,
  "description": "Conservative JavaScript obfuscation research toolkit",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "obfs-coo": "./bin/coo.js",
    "obfs-sno": "./bin/sno.js",
    "obfs-sco": "./bin/sco.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "benchmark": "node test/benchmark.js",
    "typecheck": "tsc -p jsconfig.json",
    "typecheck:external": "tsc -p jsconfig.external.json",
    "test:browser": "node test/browser-integration.js"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.5",
    "parse5": "7.3.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.8.3",
    "puppeteer-core": "25.16.0"
  }
}
